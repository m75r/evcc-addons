[Unit]
Description=evcc addons proxy
After=network-online.target evcc.service
Wants=network-online.target

[Service]
User=evcc-addons
Group=evcc-addons
ExecStart=/usr/bin/node /opt/evcc-addons/server.mjs --config /etc/evcc-addons/config.json
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/evcc-addons
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
