{
  "id": "consumers",
  "name": {
    "de": "Verbraucher",
    "en": "Consumers"
  },
  "version": "2.0.0",
  "description": {
    "de": "Zeigt Steckdosen-Ladepunkte und Verbraucher aus evcc live an. Schalter kommen von Steckdosen-Addons.",
    "en": "Shows smart-plug loadpoints and consumers from evcc live. Buttons come from smart-plug addons."
  },
  "apiVersion": 2,
  "entry": "index.js",
  "settings": [
    {
      "key": "showEnergy",
      "type": "boolean",
      "label": {
        "de": "Verbraucht anzeigen",
        "en": "Show consumption"
      },
      "default": true
    },
    {
      "key": "sort",
      "type": "select",
      "label": {
        "de": "Sortierung",
        "en": "Sort order"
      },
      "default": "name-asc",
      "options": [
        {
          "value": "name-asc",
          "label": {
            "de": "Name A–Z",
            "en": "Name A–Z"
          }
        },
        {
          "value": "name-desc",
          "label": {
            "de": "Name Z–A",
            "en": "Name Z–A"
          }
        },
        {
          "value": "power-desc",
          "label": {
            "de": "Leistung absteigend",
            "en": "Power descending"
          }
        },
        {
          "value": "power-asc",
          "label": {
            "de": "Leistung aufsteigend",
            "en": "Power ascending"
          }
        }
      ]
    }
  ]
}
