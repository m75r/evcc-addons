{
  "name": "evcc-addons",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "description": "Reverse proxy that extends evcc with installable addons",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "addons/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && tsc -b",
    "format": "prettier --write .",
    "dev": "npm run build && node scripts/dev-seed.mjs && node packages/proxy/dist/server.mjs --config dev/config.json",
    "e2e": "npm run build && playwright test -c e2e",
    "package": "node scripts/release.mjs",
    "test:package": "npm run package && vitest run -c vitest.package.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
